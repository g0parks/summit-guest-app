// Summit Guest App — data model
// Token → Stay (the trip) → { Guest, Property, Itinerary, Requests, Tab, Cards }

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooled (pgbouncer, :6543)
  directUrl = env("DIRECT_URL") // Supabase direct (:5432), for migrations
}

generator client {
  provider = "prisma-client-js"
}

enum ServiceCategory {
  DINING
  TRANSPORT
  ACTIVITY
  WELLNESS
  HOUSEHOLD
  PROVISIONING
  OTHER
}

enum PriceUnit {
  FLAT
  PER_HOUR
  PER_DAY
  PER_PERSON
  QUOTE
}

enum ItineraryCategory {
  ARRIVAL
  DINING
  ACTIVITY
  TRANSPORT
  WELLNESS
  DEPARTURE
  NOTE
}

enum RequestStatus {
  REQUESTED
  CONFIRMED
  SCHEDULED
  COMPLETED
  DECLINED
  CANCELLED
}

enum TabItemStatus {
  PENDING
  CHARGED
  REFUNDED
  VOID
}

enum PaymentProviderType {
  MOCK
  STRIPE
}

enum PerkClaimStatus {
  CLAIMED
  FULFILLED
  CANCELLED
}

/// Partner PM brand — the theming resolution point. Co-brand renders
/// "<name> Concierge, powered by Summit": PM primary, Summit quiet.
/// Tokens stay minimal (name + logo + one accent) until a real partner
/// forces more. No multi-tenancy — display theming only.
model Partner {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String // "Luxury Park City Rentals"
  conciergeLabel String? // optional override; default co-brand = "<name> Concierge"
  logoUrl        String? // optional; text wordmark fallback when null
  accentColor    String? // hex, e.g. "#7A6248"; null = Summit default accent
  isActive       Boolean    @default(true)
  properties     Property[]
  perks          Perk[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

/// Perk Bank — complimentary gifts that double as first-party capture.
/// Guest-facing register is "with our compliments"; NEVER "exclusive",
/// rev-share, or vendor-funded language anywhere a guest or PM sees.
model Perk {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String // "Recovery Lounge Session"
  vendorName String? // "Avanto"
  shortDesc  String
  longDesc   String?
  valueLabel String? // UNRENDERED since 2026-06-10 — dollar-value framing stripped from guest UI; column kept in case value framing returns
  heroImage  String?
  costCents  Int? // INTERNAL qualified-CAC — NEVER guest- or PM-facing
  partnerId  String? // null = available across all partners
  partner    Partner?    @relation(fields: [partnerId], references: [id])
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)
  claims     PerkClaim[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

/// A claim = the gift moment + the contact/opt-in left behind.
model PerkClaim {
  id             String          @id @default(cuid())
  perkId         String
  perk           Perk            @relation(fields: [perkId], references: [id])
  stayId         String
  stay           Stay            @relation(fields: [stayId], references: [id])
  email          String?
  phone          String?
  marketingOptIn Boolean         @default(false)
  status         PerkClaimStatus @default(CLAIMED)
  operatorNote   String?
  createdAt      DateTime        @default(now())

  @@unique([stayId, perkId]) // one claim per perk per stay
}

model Property {
  id           String   @id @default(cuid())
  name         String
  partnerId    String?
  partner      Partner? @relation(fields: [partnerId], references: [id])
  addressLine1 String?
  city         String?
  region       String?
  postalCode   String?
  timezone     String   @default("America/Denver")
  checkInTime  String? // "16:00"
  checkOutTime String? // "10:00"
  wifiNetwork  String?
  wifiPassword String?
  heroImage    String?
  description  String?
  stays        Stay[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Guest {
  id          String       @id @default(cuid())
  firstName   String
  lastName    String?
  email       String? // optional re-entry binding
  phone       String?
  notes       String? // VIP prefs
  stays       Stay[]
  tripIntakes TripIntake[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

/// The trip; what a token unlocks.
model Stay {
  id              String           @id @default(cuid())
  guestId         String
  guest           Guest            @relation(fields: [guestId], references: [id])
  propertyId      String
  property        Property         @relation(fields: [propertyId], references: [id])
  arrivalDate     DateTime
  departureDate   DateTime
  partySize       Int?
  currency        String           @default("usd")
  status          String           @default("upcoming") // upcoming | active | completed (display)
  isDemo          Boolean          @default(false) // /demo sandbox — cleanup-eligible, [DEMO]-tagged notifications
  accessTokens    AccessToken[]
  itineraryItems  ItineraryItem[]
  serviceRequests ServiceRequest[]
  tabLineItems    TabLineItem[]
  paymentMethods  PaymentMethod[]
  perkClaims      PerkClaim[]
  tripIntakes     TripIntake[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

/// id is generated in app code (high-entropy); URL token = "<id>.<hmac>".
/// DB stores only the id — never the secret or the signature.
model AccessToken {
  id             String    @id // crypto.randomBytes(16).base64url
  stayId         String
  stay           Stay      @relation(fields: [stayId], references: [id])
  label          String? // "pre-arrival email"
  utmJson        Json? // attribution only, never access
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
}

/// Global catalog, seeded.
model Service {
  id                String           @id @default(cuid())
  slug              String           @unique
  name              String
  category          ServiceCategory
  shortDesc         String
  longDesc          String?
  heroImage         String?
  priceAmount       Int? // cents; null for pure QUOTE
  priceUnit         PriceUnit        @default(FLAT)
  priceNote         String? // "from", "per night", etc.
  leadTimeHours     Int              @default(24)
  requiresDate      Boolean          @default(true)
  requiresTime      Boolean          @default(false)
  requiresPartySize Boolean          @default(false)
  isActive          Boolean          @default(true)
  sortOrder         Int              @default(0)
  requests          ServiceRequest[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model ServiceRequest {
  id            String         @id @default(cuid())
  stayId        String
  stay          Stay           @relation(fields: [stayId], references: [id])
  serviceId     String?
  service       Service?       @relation(fields: [serviceId], references: [id])
  customTitle   String? // free-form "ask the concierge" request
  status        RequestStatus  @default(REQUESTED)
  requestedFor  DateTime?
  partySize     Int?
  notes         String?
  quotedAmount  Int? // cents, for QUOTE services once priced
  detailsJson   Json? // fulfillment details [{label, value}] from the per-service form fields (demo-level shape)
  operatorNote  String?
  tabLineItems  TabLineItem[]
  itineraryItem ItineraryItem?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// Running-tab source of truth.
model TabLineItem {
  id               String          @id @default(cuid())
  stayId           String
  stay             Stay            @relation(fields: [stayId], references: [id])
  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  description      String
  amount           Int // cents; +charge / -credit
  currency         String          @default("usd")
  status           TabItemStatus   @default(PENDING)
  paymentMethodId  String?
  paymentMethod    PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  externalRef      String? // future Stripe PaymentIntent id
  // Per-line internal economics — NEVER guest- or PM-facing (ops console only).
  vendorCostCents  Int? // internal: what the vendor charges us
  pmShareCents     Int? // internal: PM rev-share (Phase-2; 0/null today)
  netCents         Int? // internal: amount - vendorCost - pmShare, computed on write
  occurredAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())
}

/// Card on file (mock now, Stripe later).
model PaymentMethod {
  id           String              @id @default(cuid())
  stayId       String
  stay         Stay                @relation(fields: [stayId], references: [id])
  provider     PaymentProviderType @default(MOCK)
  brand        String
  last4        String
  expMonth     Int
  expYear      Int
  isDefault    Boolean             @default(true)
  externalRef  String? // future Stripe PaymentMethod/Customer id
  tabLineItems TabLineItem[]
  createdAt    DateTime            @default(now())
}

/// World-B pre-arrival lead: the guided trip-intake at /plan. This IS the
/// lead record — interest signals, the open note, contact, attribution.
/// Nullable guest/stay links keep the convert-to-Guest/Stay path open
/// (World A). One row per completed flow; no partial rows.
model TripIntake {
  id          String   @id @default(cuid())
  name        String?
  email       String?
  phone       String?
  tripTiming  String? // loose free text: "mid-February, presidents' week"
  answersJson Json // [{ key, question, answer: "interested"|"declined", serviceSlug }]
  note        String? // typed capstone — the high-signal open capture
  utmJson     Json? // attribution only, never access (AccessToken.utmJson precedent)
  source      String? // ?src= on the inbound link (sms | email | …)
  stayId      String? // set when a known-guest session existed at intake time
  stay        Stay?    @relation(fields: [stayId], references: [id])
  guestId     String? // future World-A conversion
  guest       Guest?   @relation(fields: [guestId], references: [id])
  createdAt   DateTime @default(now())
}

model ItineraryItem {
  id               String            @id @default(cuid())
  stayId           String
  stay             Stay              @relation(fields: [stayId], references: [id])
  serviceRequestId String?           @unique // a confirmed request can surface here
  serviceRequest   ServiceRequest?   @relation(fields: [serviceRequestId], references: [id])
  title            String
  description      String?
  location         String?
  category         ItineraryCategory @default(NOTE)
  startsAt         DateTime
  endsAt           DateTime?
  allDay           Boolean           @default(false)
  changePending    Boolean           @default(false) // operator-set: guest sees a quiet "Being rearranged" chip
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}
