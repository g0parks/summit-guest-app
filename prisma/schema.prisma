// Summit Guest App — data model
// Token → Stay (the trip) → { Guest, Property, Itinerary, Requests, Tab, Cards }

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooled (pgbouncer, :6543)
  directUrl = env("DIRECT_URL") // Supabase direct (:5432), for migrations
}

generator client {
  provider = "prisma-client-js"
}

enum ServiceCategory {
  DINING
  TRANSPORT
  ACTIVITY
  WELLNESS
  HOUSEHOLD
  PROVISIONING
  OTHER
}

enum PriceUnit {
  FLAT
  PER_HOUR
  PER_DAY
  PER_PERSON
  QUOTE
  // Provisioning (grocery + bar): no fixed price and no quotable total — the
  // guest consents to a disclosed cost-plus fee SCHEDULE on the confirm screen
  // (pass-through cost + delivery fee + service % + same-day rush), and a human
  // prices the order after curating it. See src/lib/provisioningPricing.ts.
  FEE_STRUCTURE
}

enum ItineraryCategory {
  ARRIVAL
  DINING
  ACTIVITY
  TRANSPORT
  WELLNESS
  DEPARTURE
  NOTE
}

/// The request lifecycle (Product Doctrine 2026-06-12). Two pricing paths:
/// fixed-price completes SIGNALED → CONFIRMED directly (no quote, no
/// approval); QUOTE-priced runs SIGNALED → READY → QUOTED → CONFIRMED with
/// the guest's in-app approval tap in between. EXPIRED = the stay departed
/// with the signal still open — kept as demand data, never deleted.
enum RequestStatus {
  SIGNALED
  READY
  QUOTED
  CONFIRMED
  SCHEDULED
  COMPLETED
  DECLINED
  CANCELLED
  EXPIRED
}

enum Season {
  WINTER
  SUMMER
  ALL_YEAR
}

enum ChangeKind {
  MOVE
  CANCEL
  MODIFY
}

enum ChangeStatus {
  OPEN
  APPLIED
  DECLINED
}

/// The decided pre-arrival cadence (Ops Decisions): at booking · ~2wk
/// post-booking · ~2wk pre-arrival. Operator-TRIGGERED, never automated —
/// the system surfaces what's due; a human sends it.
enum TouchKind {
  WELCOME
  PLAN_AHEAD
  PRE_ARRIVAL
}

enum TabItemStatus {
  PENDING
  CHARGED
  REFUNDED
  VOID
}

enum PaymentProviderType {
  MOCK
  STRIPE
}

enum PerkClaimStatus {
  CLAIMED
  FULFILLED
  CANCELLED
}

/// One sent cadence touch per stay per kind — the record that keeps the
/// Touchpoints panel honest ("sent Mar 3 · email") and double-sends
/// impossible. Channel "console" = the zero-config dev fallback printed
/// the email instead of Resend delivering it.
model GuestTouch {
  id        String    @id @default(cuid())
  stayId    String
  stay      Stay      @relation(fields: [stayId], references: [id])
  kind      TouchKind
  channel   String    @default("email") // "email" | "console"
  sentTo    String?
  createdAt DateTime  @default(now())

  @@unique([stayId, kind])
}

/// Partner PM brand — the theming resolution point. Co-brand renders
/// "<name> Concierge, powered by Summit": PM primary, Summit quiet.
/// Tokens stay minimal (name + logo + one accent) until a real partner
/// forces more. No multi-tenancy — display theming only.
model Partner {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String // "Luxury Park City Rentals"
  conciergeLabel String? // optional override; default co-brand = "<name> Concierge"
  logoUrl        String? // optional; text wordmark fallback when null
  accentColor    String? // hex, e.g. "#7A6248"; null = Summit default accent
  isActive       Boolean    @default(true)
  properties     Property[]
  perks          Perk[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

/// Perk Bank — complimentary gifts that double as first-party capture.
/// Guest-facing register is "with our compliments"; NEVER "exclusive",
/// rev-share, or vendor-funded language anywhere a guest or PM sees.
model Perk {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String // "Recovery Lounge Session"
  vendorName String? // "Avanto"
  shortDesc  String
  longDesc   String?
  valueLabel String? // UNRENDERED since 2026-06-10 — dollar-value framing stripped from guest UI; column kept in case value framing returns
  heroImage  String?
  costCents  Int? // INTERNAL qualified-CAC — NEVER guest- or PM-facing
  partnerId  String? // null = available across all partners
  partner    Partner?    @relation(fields: [partnerId], references: [id])
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)
  claims     PerkClaim[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

/// A claim = the gift moment + the contact/opt-in left behind.
model PerkClaim {
  id             String          @id @default(cuid())
  perkId         String
  perk           Perk            @relation(fields: [perkId], references: [id])
  stayId         String
  stay           Stay            @relation(fields: [stayId], references: [id])
  email          String?
  phone          String?
  marketingOptIn Boolean         @default(false)
  status         PerkClaimStatus @default(CLAIMED)
  operatorNote   String?
  createdAt      DateTime        @default(now())

  @@unique([stayId, perkId]) // one claim per perk per stay
}

model Property {
  id           String   @id @default(cuid())
  name         String
  partnerId    String?
  partner      Partner? @relation(fields: [partnerId], references: [id])
  addressLine1 String?
  city         String?
  region       String?
  postalCode   String?
  timezone     String   @default("America/Denver")
  checkInTime  String? // "16:00"
  checkOutTime String? // "10:00"
  wifiNetwork  String?
  wifiPassword String?
  heroImage    String?
  description  String?
  stays        Stay[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Guest {
  id          String       @id @default(cuid())
  firstName   String
  lastName    String?
  email       String? // optional re-entry binding
  phone       String?
  notes       String? // VIP prefs
  stays       Stay[]
  tripIntakes TripIntake[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

/// The trip; what a token unlocks.
model Stay {
  id              String           @id @default(cuid())
  guestId         String
  guest           Guest            @relation(fields: [guestId], references: [id])
  propertyId      String
  property        Property         @relation(fields: [propertyId], references: [id])
  arrivalDate     DateTime
  departureDate   DateTime
  partySize       Int?
  currency        String           @default("usd")
  status          String           @default("upcoming") // write-only legacy display — phase is DERIVED from dates (src/lib/stayPhase.ts)
  hasRentalCar    Boolean? // captured pre-arrival (/plan or in-app fallback); null = not yet asked. Re-prices the distance-activity menu in v2 — stored, not acted on in v1.
  isDemo          Boolean          @default(false) // /demo sandbox — cleanup-eligible, [DEMO]-tagged notifications
  accessTokens    AccessToken[]
  itineraryItems  ItineraryItem[]
  serviceRequests ServiceRequest[]
  tabLineItems    TabLineItem[]
  paymentMethods  PaymentMethod[]
  perkClaims      PerkClaim[]
  tripIntakes     TripIntake[]
  changeRequests  ChangeRequest[]
  guestTouches    GuestTouch[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

/// id is generated in app code (high-entropy); URL token = "<id>.<hmac>".
/// DB stores only the id — never the secret or the signature.
model AccessToken {
  id             String    @id // crypto.randomBytes(16).base64url
  stayId         String
  stay           Stay      @relation(fields: [stayId], references: [id])
  label          String? // "pre-arrival email"
  utmJson        Json? // attribution only, never access
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
}

/// Global catalog, seeded.
model Service {
  id                String           @id @default(cuid())
  slug              String           @unique
  name              String
  category          ServiceCategory
  shortDesc         String
  longDesc          String?
  heroImage         String?
  priceAmount       Int? // cents; null for pure QUOTE / FEE_STRUCTURE
  priceUnit         PriceUnit        @default(FLAT)
  priceNote         String? // "from", "per night", etc.
  // FEE_STRUCTURE knobs — tunable per service; null falls back to the code
  // defaults in src/lib/provisioningPricing.ts. (Cadence/cutoff/closed-day
  // logic stays in code config, not columns.)
  deliveryFeeCents  Int? // flat delivery/shopping fee
  serviceFeeBps     Int? // service fee, basis points of pass-through cost (2500 = 25%)
  rushFeeCents      Int? // flat same-day / late-order rush fee
  leadTimeHours     Int              @default(24)
  season            Season           @default(ALL_YEAR) // stay dates pick the menu (winter/summer)
  moveCutoffHours   Int? // in-app "move it" offered until this many hours before; null = concierge-only
  cancelCutoffHours Int? // in-app cancel offered until this many hours before; null = concierge-only
  requiresDate      Boolean          @default(true)
  requiresTime      Boolean          @default(false)
  requiresPartySize Boolean          @default(false)
  isActive          Boolean          @default(true)
  sortOrder         Int              @default(0)
  requests          ServiceRequest[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model ServiceRequest {
  id            String         @id @default(cuid())
  stayId        String
  stay          Stay           @relation(fields: [stayId], references: [id])
  serviceId     String?
  service       Service?       @relation(fields: [serviceId], references: [id])
  customTitle   String? // free-form "ask the concierge" request
  status        RequestStatus   @default(SIGNALED)
  source        String          @default("catalog") // "catalog" | "intake" | "ops" — where the signal came from
  requestedFor  DateTime?
  partySize     Int?
  notes         String?
  quotedAmount  Int? // cents, for QUOTE services once priced
  detailsJson   Json? // fulfillment details [{label, value}] from the per-service form fields (demo-level shape)
  operatorNote  String?
  tabLineItems  TabLineItem[]
  itineraryItem ItineraryItem?
  changeRequests ChangeRequest[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

/// A guest's structured ask to move/cancel/modify something already on the
/// itinerary. Offered in-app only inside the service's cutoff window; past
/// the cutoff the guest gets the quiet concierge escape hatch instead.
model ChangeRequest {
  id               String          @id @default(cuid())
  stayId           String
  stay             Stay            @relation(fields: [stayId], references: [id])
  itineraryItemId  String
  itineraryItem    ItineraryItem   @relation(fields: [itineraryItemId], references: [id])
  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  kind             ChangeKind
  requestedDate    String? // wall-clock "YYYY-MM-DD" in property tz (MOVE)
  requestedTime    String? // wall-clock "HH:mm" in property tz (MOVE)
  note             String?
  status           ChangeStatus    @default(OPEN)
  resolvedAt       DateTime?
  createdAt        DateTime        @default(now())
}

/// Running-tab source of truth.
model TabLineItem {
  id               String          @id @default(cuid())
  stayId           String
  stay             Stay            @relation(fields: [stayId], references: [id])
  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  description      String
  amount           Int // cents; +charge / -credit
  currency         String          @default("usd")
  status           TabItemStatus   @default(PENDING)
  paymentMethodId  String?
  paymentMethod    PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  externalRef      String? // future Stripe PaymentIntent id
  // Per-line internal economics — NEVER guest- or PM-facing (ops console only).
  vendorCostCents  Int? // internal: what the vendor charges us
  pmShareCents     Int? // internal: PM rev-share (Phase-2; 0/null today)
  netCents         Int? // internal: amount - vendorCost - pmShare, computed on write
  occurredAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())
}

/// Card on file (mock now, Stripe later).
model PaymentMethod {
  id           String              @id @default(cuid())
  stayId       String
  stay         Stay                @relation(fields: [stayId], references: [id])
  provider     PaymentProviderType @default(MOCK)
  brand        String
  last4        String
  expMonth     Int
  expYear      Int
  isDefault    Boolean             @default(true)
  externalRef  String? // future Stripe PaymentMethod/Customer id
  tabLineItems TabLineItem[]
  createdAt    DateTime            @default(now())
}

/// World-B pre-arrival lead: the guided trip-intake at /plan. This IS the
/// lead record — interest signals, the open note, contact, attribution.
/// Nullable guest/stay links keep the convert-to-Guest/Stay path open
/// (World A). One row per completed flow; no partial rows.
model TripIntake {
  id          String   @id @default(cuid())
  name        String?
  email       String?
  phone       String?
  tripTiming  String? // loose free text: "mid-February, presidents' week"
  answersJson Json // [{ key, question, answer: "interested"|"declined", serviceSlug }]
  note        String? // typed capstone — the high-signal open capture
  utmJson     Json? // attribution only, never access (AccessToken.utmJson precedent)
  source      String? // ?src= on the inbound link (sms | email | …)
  stayId      String? // set when a known-guest session existed at intake time
  stay        Stay?    @relation(fields: [stayId], references: [id])
  guestId     String? // future World-A conversion
  guest       Guest?   @relation(fields: [guestId], references: [id])
  convertedAt DateTime? // operator converted this lead into a Stay — doubles as the conversion idempotency claim
  createdAt   DateTime @default(now())
}

model ItineraryItem {
  id               String            @id @default(cuid())
  stayId           String
  stay             Stay              @relation(fields: [stayId], references: [id])
  serviceRequestId String?           @unique // a confirmed request can surface here
  serviceRequest   ServiceRequest?   @relation(fields: [serviceRequestId], references: [id])
  title            String
  description      String?
  location         String?
  category         ItineraryCategory @default(NOTE)
  startsAt         DateTime
  endsAt           DateTime?
  allDay           Boolean           @default(false)
  changePending    Boolean           @default(false) // set while a ChangeRequest is OPEN: guest sees a quiet "Being rearranged" chip
  sortOrder        Int               @default(0)
  changeRequests   ChangeRequest[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}
