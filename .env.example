# ── Database (Supabase Postgres) ──────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# Pooled (Transaction, port 6543) for the app runtime:
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (Session, port 5432) for Prisma migrations:
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Access tokens ─────────────────────────────────────────────
# Long random secret used to HMAC-sign per-guest access tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SUMMIT_TOKEN_SECRET="change-me-to-a-long-random-string"

# ── App ───────────────────────────────────────────────────────
# Base URL used for demo links (seed / new-demo-token), deep links in operator
# emails, and the ops-link script. Server-only — not NEXT_PUBLIC_.
APP_BASE_URL="http://localhost:3000"

# ── Payments (Stripe) ─────────────────────────────────────────
# Provider selection is PER STAY: /demo sandboxes are ALWAYS mock (a pitch never
# touches real money). For real stays, "stripe" needs BOTH keys below — with one
# missing it logs loudly and falls back to mock. "mock" = the instant rollback.
PAYMENTS_PROVIDER="mock"
# Stripe dashboard → Developers → API keys (test keys start sk_test_ / pk_test_).
# Charging is operator-tapped in /ops; there is no cron and no webhook endpoint,
# so no webhook secret is needed. Refunds are done in the Stripe dashboard.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Operator notifications (Resend) ──────────────────────────
# Both unset → notifications fall back to server console logs (dev/local works
# with zero config). Key from resend.com (free tier: 100/day, plenty).
# Sender is ops@summitluxurylogistics.com (domain verified in Resend
# 2026-06-22), so OPERATOR_EMAIL can be any inbox.
RESEND_API_KEY=""
OPERATOR_EMAIL="you@example.com"

# ── Ops console ───────────────────────────────────────────────
# Long random secret gating /ops (single operator; rotation = change the value).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Entry link: npm run ops:link
OPS_KEY="change-me-to-a-long-random-string"

# ── Guest emails (welcome email, future pre-arrival cadence) ─
# Sender for GUEST-facing email (src/lib/guestEmail.ts) — distinct from the
# operator notifications above. Unset → guest email disabled entirely (the
# welcome-email toggle is absent from ops; sms/copy fallbacks remain).
# Set without RESEND_API_KEY → console fallback prints the full email.
# GUEST_EMAIL_FROM="Summit Concierge <concierge@yourdomain.com>"

# ── Concierge Line ────────────────────────────────────────────
# The human texting line guests reach via sms:/tel:/mailto: deep links.
# Phone is E.164. PHONE unset → text/call CTAs quietly absent, email-only.
# BOTH unset → concierge surfaces absent entirely (nothing looks broken).
# CONCIERGE_PHONE="+14355550100"
# CONCIERGE_EMAIL="concierge@example.com"
