# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
/build

# production
/dist

# env / secrets — NEVER commit these
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# prisma
# (keep schema.prisma + migrations tracked; ignore generated client if it lands in repo)
/prisma/generated

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# os / editor cruft
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea

# misc
*.pem
.vercel
*.tsbuildinfo
next-env.d.ts

# claude code local-only memory (personal notes / sensitive paths, never in git)
CLAUDE.local.md

# claude code local session state (settings, worktrees) — machine-local, never in git
/.claude/

# scratch — local verify scripts & screenshots, never in git
/.scratch/
